<h1>Edit Coffee Bean</h1>

<%= form_with model: @coffee_bean, local: true, multipart: true do |form| %>
  <% if @coffee_bean.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@coffee_bean.errors.count, "error") %> prohibited this coffee bean from being saved:</h2>
      <ul>
        <% @coffee_bean.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :brand %>
    <%= form.text_field :brand %>
  </div>

  <div class="field">
    <%= form.label :origin %>
    <%= form.text_field :origin %>
  </div>

  <div class="field">
    <%= form.label :variety, "Varieties" %>
    <div class="flex flex-col gap-1">
      <% Variety.order(:name).each_with_index do |variety, idx| %>
        <% cbv = @coffee_bean.coffee_bean_varieties.find { |u| u.variety_id == variety.id } %>
        <div class="flex items-center gap-2">
          <%= check_box_tag "coffee_bean[variety_selection][#{idx}][enabled]", "1", cbv.present? %>
          <%= label_tag "coffee_bean_variety_selection_#{idx}_enabled", variety.name %>
          <%= number_field_tag "coffee_bean[variety_selection][#{idx}][percentage]", cbv&.percentage, min: 1, max: 100, placeholder: "%", class: "w-20" %>
          <%= hidden_field_tag "coffee_bean[variety_selection][#{idx}][variety_id]", variety.id %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="field">
    <%= form.label :process, "Processing Methods" %>
    <div class="flex flex-col gap-1">
      <% ProcessingMethod.order(:name).each_with_index do |method, idx| %>
        <% selected = @coffee_bean.processing_method_ids.include?(method.id) %>
        <div class="flex items-center gap-2">
          <%= check_box_tag "coffee_bean[processing_method_selection][#{idx}][enabled]", "1", selected %>
          <%= label_tag "coffee_bean_processing_method_selection_#{idx}_enabled", method.name %>
          <%= hidden_field_tag "coffee_bean[processing_method_selection][#{idx}][processing_method_id]", method.id %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="field">
    <%= form.label :tasting_notes %>
    <%= form.text_field :tasting_notes %>
  </div>

  <div class="field">
    <%= form.label :producer %>
    <%= form.text_field :producer %>
  </div>

  <div class="field">
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>

  <div class="field">
    <%= form.label :images, "Add more images (optional)" %>
    <%= form.file_field :images, multiple: true, accept: "image/*" %>
  </div>

  <div class="actions">
    <%= form.submit "Update Coffee Bean" %>
  </div>
<% end %>

<%= link_to 'Show', @coffee_bean %> |
<%= link_to 'Back', coffee_beans_path %>